{
  "name": "wishnath",
  "version": "1.0.0",
  "private": true,
  "description": "WishNath — Tout ce qui me ferait plaisir, au même endroit. Liste de Noël privée (Firebase).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore",
    "dev:emulators": "vite --mode emulators",
    "test:rules": "firebase emulators:exec --only firestore \"node tests/rules.test.mjs\"",
    "deploy": "npm run build && firebase deploy",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.0",
    "@fontsource-variable/instrument-sans": "^5.2.0",
    "firebase": "^11.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "firebase-tools": "^13.0.0",
    "vite": "^6.0.0"
  }
}
